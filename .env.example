TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional. Regex matched against the landing URL so session healing reacts to
# 200 login walls, not just 401/403 responses. Without it, healing uses the
# main-document status only.
# JEV_LOGIN_URL_PATTERN=/(login|signin)
# Optional. Answer HTTP basic-auth challenges with these credentials. Interception
# covers document navigations of one origin only: JEV_BASIC_AUTH_ORIGIN (repeat
# hosts comma-separated) when set, otherwise the landing origin of the run. Runs
# against every other origin are never intercepted, so SPA data calls flow freely.
# JEV_BASIC_AUTH_USERNAME=
# JEV_BASIC_AUTH_PASSWORD=
# JEV_BASIC_AUTH_ORIGIN=protected.example.com
# Optional. Credentials for scripts/e2e_auth.py (staging auth lifecycle).
# JEV_E2E_BASE_URL=https://staging.example.com
# JEV_E2E_EMAIL=staging-accept@example.com
# E2E_RESEND_API_KEY=
# JEV_E2E_AUTH_ORIGINS=https://sso.example.com
# JEV_CDP_URL=http://127.0.0.1:9333
# Optional. Parallel sessions each need a unique BU_NAME plus the endpoint of a
# dedicated Chrome (scripts/automation_chrome.py --profile prints the pair).
# Changing only the endpoint reuses another session's daemon — and its browser.
# BU_NAME=
# BU_CDP_WS=
# Optional. Where scripts/session.py stores cookie snapshots (default ~/.jev-ultrafast/sessions).
# JEV_SESSIONS_DIR=
# Multi-agent: give each concurrent agent process its own name and it gets its own
# browser-harness daemon, tab, and CDP event stream against the shared Chrome.
# JEV_AGENT_NAME wins over BU_NAME. Same-origin runs coordinate through lock files
# under ~/.jev-ultrafast/locks (redirect with JEV_LOCKS_DIR); scripts/orchestrate.py
# assigns names and queues same-origin tasks for you.
# JEV_AGENT_NAME=
# JEV_LOCKS_DIR=
