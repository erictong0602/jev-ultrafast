TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional. Regex matched against the landing URL so session healing reacts to
# 200 login walls, not just 401/403 responses. Without it, healing uses the
# main-document status only.
# JEV_LOGIN_URL_PATTERN=/(login|signin)
# Optional. Credentials for scripts/e2e_auth.py (staging auth lifecycle).
# JEV_E2E_BASE_URL=https://staging.example.com
# JEV_E2E_EMAIL=staging-accept@example.com
# E2E_RESEND_API_KEY=
# JEV_E2E_AUTH_ORIGINS=https://sso.example.com
# JEV_CDP_URL=http://127.0.0.1:9333
